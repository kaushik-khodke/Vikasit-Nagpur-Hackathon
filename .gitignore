# =============================================================================
# TigerTrace - Production Git Ignore Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Python, Bytecode & Virtual Environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# -----------------------------------------------------------------------------
# 2. Node & Web Frontend (React / Vite)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.env

# -----------------------------------------------------------------------------
# 3. Large Machine Learning Models & Checkpoints (> 5MB)
# -----------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.engine
*.safetensors
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors
**/models/*.pt
**/models/*.pth
**/models/*.bin
**/models/*.safetensors
yolov8n.pt
**/yolov8n.pt
!**/models/.gitkeep

# -----------------------------------------------------------------------------
# 4. Large Video Streams, Temporary Subsampled Frames & Quarantine
# -----------------------------------------------------------------------------
*.mp4
*.webm
*.avi
*.mov
*.mkv
**/temp_video_frames/
**/quarantine/
!**/.gitkeep

# -----------------------------------------------------------------------------
# 5. Environment Variables & Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# -----------------------------------------------------------------------------
# 6. Database Storage Volumes, Dumps & Logs
# -----------------------------------------------------------------------------
pgdata/
**/pgdata/
*.sql.dump
*.log
logs/
**/logs/
benchmark_report.json
**/benchmark_report.json

# -----------------------------------------------------------------------------
# 7. Operating System & IDE Editor Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Visual Studio Code & JetBrains
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?



.jpg
.png